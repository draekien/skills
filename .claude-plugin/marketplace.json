{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "draekien-skills",
  "owner": {
    "name": "William Pei",
    "email": "draekien@users.noreply.github.com"
  },
  "metadata": {
    "description": "Agent skills organised into buckets by domain."
  },
  "plugins": [
    {
      "name": "everything",
      "description": "All public-facing skills in this repository across every domain bucket.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/productivity/get-aligned",
        "./skills/productivity/deep-research",
        "./skills/productivity/transcribe-video",
        "./skills/productivity/visualise",
        "./skills/productivity/todo",
        "./skills/problem-solving/round-table",
        "./skills/problem-solving/from-first-principles",
        "./skills/roles/steelman",
        "./skills/roles/devils-advocate",
        "./skills/roles/rubber-duck",
        "./skills/context-management/extract-llms-txt",
        "./skills/context-management/init-agent-docs",
        "./skills/context-management/maintain-agent-docs",
        "./skills/engineering/with-ubiquitous-language",
        "./skills/engineering/module-design",
        "./skills/engineering/draft-a-prd",
        "./skills/engineering/break-down-prd",
        "./skills/engineering/with-testing-principles",
        "./skills/engineering/extract-llms-txt",
        "./skills/engineering/init-agent-docs",
        "./skills/engineering/maintain-agent-docs",
        "./skills/engineering/with-doc-comments",
        "./skills/ui-ux/design-callouts",
        "./skills/ui-ux/design-dashboards",
        "./skills/output-styles/cte-mode",
        "./skills/output-styles/eli10-mode",
        "./skills/output-styles/plain-language",
        "./skills/output-styles/simplified-technical-english",
        "./skills/meta/customize-skill",
        "./skills/meta/writing-skills",
        "./skills/productivity/picking-models",
        "./skills/engineering/prune-local-branches",
        "./skills/engineering/harden"
      ],
      "outputStyles": [
        "./skills/output-styles/cte-mode/cte-mode.md",
        "./skills/output-styles/eli10-mode/eli10-mode.md",
        "./skills/output-styles/plain-language/plain-language.md",
        "./skills/output-styles/simplified-technical-english/simplified-technical-english.md"
      ],
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "Skill",
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/meta/customize-skill/hooks/inject-customizations.sh\"",
                "timeout": 10
              }
            ]
          }
        ]
      },
      "version": "0.62.0"
    },
    {
      "name": "engineering-skills",
      "description": "Skills for software development tasks: code review, debugging, architecture, and technical workflows.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/engineering/with-ubiquitous-language",
        "./skills/engineering/module-design",
        "./skills/engineering/draft-a-prd",
        "./skills/engineering/break-down-prd",
        "./skills/engineering/with-testing-principles",
        "./skills/engineering/extract-llms-txt",
        "./skills/engineering/init-agent-docs",
        "./skills/engineering/maintain-agent-docs",
        "./skills/engineering/with-doc-comments",
        "./skills/engineering/prune-local-branches",
        "./skills/engineering/harden"
      ],
      "version": "0.28.0"
    },
    {
      "name": "context-management-skills",
      "description": "Skills for building and managing agent context: the documentation and reference indexes an agent reads before it touches the code.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/context-management/extract-llms-txt",
        "./skills/context-management/init-agent-docs",
        "./skills/context-management/maintain-agent-docs"
      ],
      "version": "0.1.0"
    },
    {
      "name": "productivity-skills",
      "description": "Skills for general workplace productivity: summarisation, research, meeting prep, and task management.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/productivity/get-aligned",
        "./skills/productivity/deep-research",
        "./skills/productivity/transcribe-video",
        "./skills/productivity/visualise",
        "./skills/productivity/todo",
        "./skills/productivity/picking-models"
      ],
      "version": "0.16.0"
    },
    {
      "name": "problem-solving-skills",
      "description": "Skills for working through a hard problem or decision: reasoning from fundamentals, or debating between competing options.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/problem-solving/round-table",
        "./skills/problem-solving/from-first-principles"
      ],
      "version": "0.1.1"
    },
    {
      "name": "roles-skills",
      "description": "Skills that adopt a fixed persona or stance to sharpen thinking: an advocate, a listener, a critic.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/roles/steelman",
        "./skills/roles/devils-advocate",
        "./skills/roles/rubber-duck"
      ],
      "version": "0.1.1"
    },
    {
      "name": "ui-ux-skills",
      "description": "Skills for user interface and experience design: dashboards, visual design, and usability.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/ui-ux/design-callouts",
        "./skills/ui-ux/design-dashboards"
      ],
      "version": "0.3.0"
    },
    {
      "name": "output-styles",
      "description": "Skills that shift Claude's communication tone and voice.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/output-styles/cte-mode",
        "./skills/output-styles/eli10-mode",
        "./skills/output-styles/plain-language",
        "./skills/output-styles/simplified-technical-english"
      ],
      "outputStyles": [
        "./skills/output-styles/cte-mode/cte-mode.md",
        "./skills/output-styles/eli10-mode/eli10-mode.md",
        "./skills/output-styles/plain-language/plain-language.md",
        "./skills/output-styles/simplified-technical-english/simplified-technical-english.md"
      ],
      "version": "0.11.0"
    },
    {
      "name": "meta-skills",
      "description": "Meta-skills: skills about authoring, vetting, and evaluating skills themselves.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/meta/customize-skill",
        "./skills/meta/writing-skills"
      ],
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "Skill",
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/meta/customize-skill/hooks/inject-customizations.sh\"",
                "timeout": 10
              }
            ]
          }
        ]
      },
      "version": "0.3.0"
    },
    {
      "name": "personal-skills",
      "description": "Skills for personal productivity and life admin: scheduling, decision-making, and personal organisation.",
      "source": "./",
      "strict": false,
      "skills": [
        "./skills/personal/ghost-writing"
      ],
      "version": "0.4.0"
    }
  ]
}
