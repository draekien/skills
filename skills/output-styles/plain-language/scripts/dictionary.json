  "structures": [
    {
      "id": "negative-parallelism",
      "pattern": "(?i)\\bnot just\\b[^.!?]{0,80}?(?:,\\s*(?:it|they|this|that)\\b|\\s*[—-]\\s)",
      "message": "Manufactured contrast (\"not just X, it's Y\"). State the claim directly."
    },
    {
      "id": "negative-parallelism",
      "pattern": "(?i)\\b(?:isn'?t|aren'?t|wasn'?t|weren'?t|is not|are not)\\b[^.!?]{0,80}[.;]\\s*(?:It|They|That|This)'?s\\b",
      "message": "Negative-then-positive pivot. Say what it is, without first saying what it is not."
    },
    {
      "id": "negative-parallelism",
      "pattern": "(?i)\\b(?:this|it|that)\\s+(?:isn'?t|is not)\\s+about\\b",
      "message": "\"This isn't about X\" framing. Lead with what it is about."
    },
    {
      "id": "rhetorical-scaffolding",
      "pattern": "(?i)\\bhere(?:'?s| is) the thing\\b",
      "message": "Throat-clearing. Delete it and state the point."
    },
    {
      "id": "rhetorical-scaffolding",
      "pattern": "(?i)\\bbut here(?:'?s| is) where it gets\\b",
      "message": "Manufactured reveal. Make the point without the build-up."
    },
    {
      "id": "rhetorical-scaffolding",
      "pattern": "(?i)\\bhere(?:'?s| is) why (?:that|this|it) matters\\b",
      "message": "Announcing significance instead of showing it. Delete and give the reason."
    },
    {
      "id": "rhetorical-scaffolding",
      "pattern": "(?i)\\bthe (?:kicker|best part|worst part)\\s*[?:]",
      "message": "Rhetorical set-up. State the fact plainly."
    },
    {
      "id": "rhetorical-scaffolding",
      "pattern": "(?i)\\b(?:let that sink in|make no mistake|and that(?:'?s| is) the (?:whole )?point)\\b",
      "message": "Dramatic filler. Trust the reader and cut it."
    },
    {
      "id": "hedged-discovery",
      "pattern": "(?i)\\byou have to go looking\\b",
      "message": "Manufactured insight. Say what the thing is, not how hard it is to notice."
    },
    {
      "id": "hedged-discovery",
      "pattern": "(?i)\\b(?:if you know where to look|hiding in plain sight|on closer inspection|what'?s easy to miss)\\b",
      "message": "Discovery framing. Lead with the finding itself."
    },
    {
      "id": "hedged-discovery",
      "pattern": "(?i)\\bburied in the (?:details?|fine print)\\b",
      "message": "Discovery framing. Name the detail instead."
    },
    {
      "id": "hedged-discovery",
      "pattern": "(?i)\\bat first glance\\b[^.!?]{0,120}\\bbut\\b",
      "message": "\"At first glance ... but\" reveal. Give the accurate reading first."
    },
    {
      "id": "triad",
      "pattern": "(?i)\\b[a-z]+(?:er|est|ful|ive|ous|able|ible|ly|ed)\\b,\\s+[a-z]+(?:er|est|ful|ive|ous|able|ible|ly|ed)\\b,?\\s+and\\s+[a-z]+(?:er|est|ful|ive|ous|able|ible|ly|ed)\\b",
      "message": "Rule-of-three list. Keep the items that carry information; cut the rest."
    },
    {
      "id": "em-dash-pivot",
      "pattern": "—[^—.!?]{1,120}—",
      "message": "Two em-dashes in one sentence. Use a full stop or a comma."
    }
  ],
